<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Navigation Rail -->
    <system:String x:Key="Loc_Nav_Home">Home</system:String>
    <system:String x:Key="Loc_Nav_Gallery">Gallery</system:String>
    <system:String x:Key="Loc_Nav_Shortcuts">Shortcuts</system:String>
    <system:String x:Key="Loc_Nav_Settings">Settings</system:String>
    <system:String x:Key="Loc_Nav_About">About</system:String>

    <!-- Trang chủ (HomePage) -->
    <system:String x:Key="Loc_Home_NewCapture">New Capture</system:String>
    <system:String x:Key="Loc_Home_AutoSave">Save image immediately after capture</system:String>
    <system:String x:Key="Loc_Home_AutoClipboard">Auto copy to clipboard</system:String>
    <system:String x:Key="Loc_Home_DetectedScreens">Detected {0} screens. Click on a screen to capture quickly.</system:String>
    <system:String x:Key="Loc_Home_ScanningScreens">Scanning screens...</system:String>

    <!-- Thư viện ảnh (GalleryPage) -->
    <system:String x:Key="Loc_Gallery_Title">Gallery</system:String>
    <system:String x:Key="Loc_Gallery_Subtitle">You can drag and drop images anywhere!</system:String>
    <system:String x:Key="Loc_Gallery_OpenFolder">📁 Open folder</system:String>
    <system:String x:Key="Loc_Gallery_Tooltip">Double-click to open • Hold and drag to attach or copy</system:String>

    <!-- Phím tắt (ShortcutsPage) -->
    <system:String x:Key="Loc_Shortcuts_Title">Shortcuts</system:String>
    <system:String x:Key="Loc_Shortcuts_Header">Default system-wide shortcuts:</system:String>
    <system:String x:Key="Loc_Shortcuts_OverlayDesc">Open interactive capture overlay (click anywhere on screen or press 1..9 to capture)</system:String>
    <system:String x:Key="Loc_Shortcuts_IdentifyDesc">Show screen identification overlay (auto-dismiss after 2.5s)</system:String>
    <system:String x:Key="Loc_Shortcuts_InstantDesc">Instant capture corresponding screen from anywhere on Windows</system:String>
    <system:String x:Key="Loc_Shortcuts_EscDesc">Close / Cancel interactive capture overlay and return to main window</system:String>

    <!-- Cài đặt (SettingsPage) -->
    <system:String x:Key="Loc_Settings_Title">Settings</system:String>
    <system:String x:Key="Loc_Settings_DefaultFolder">Default screenshot folder</system:String>
    <system:String x:Key="Loc_Settings_DefaultFolderDesc">Directory path where screenshots are automatically saved</system:String>
    <system:String x:Key="Loc_Settings_ChangeFolder">Change...</system:String>
    <system:String x:Key="Loc_Settings_Theme">Theme mode (Dark / Light)</system:String>
    <system:String x:Key="Loc_Settings_ThemeDesc">Use dark or light color theme</system:String>
    <system:String x:Key="Loc_Settings_MinimizeToTray">Minimize to system tray</system:String>
    <system:String x:Key="Loc_Settings_MinimizeToTrayDesc">When closing or minimizing, keep LMScreenShot running silently in system tray</system:String>
    <system:String x:Key="Loc_Settings_Language">Language</system:String>
    <system:String x:Key="Loc_Settings_LanguageDesc">Choose the display language for the application interface</system:String>

    <!-- Tray Icon -->
    <system:String x:Key="Loc_Tray_Tooltip">LMScreenShot - Click to capture (Ctrl + Shift + X)</system:String>
    <system:String x:Key="Loc_Tray_Open">Open LMScreenShot</system:String>
    <system:String x:Key="Loc_Tray_Exit">Exit</system:String>

    <!-- Thông tin (AboutPage) -->
    <system:String x:Key="Loc_About_Title">About</system:String>
    <system:String x:Key="Loc_About_Version">Version 1.0.0</system:String>
    <system:String x:Key="Loc_About_Build">Build 20261024</system:String>
    <system:String x:Key="Loc_About_Links">Links</system:String>
    <system:String x:Key="Loc_About_GitHub">LMScreenShot project on GitHub</system:String>
    <system:String x:Key="Loc_About_ThirdParty">Third-party libraries</system:String>

    <!-- Overlay & Toast Notifications -->
    <system:String x:Key="Loc_Overlay_Tip">Click anywhere or press number key to capture | Esc to cancel</system:String>
    <system:String x:Key="Loc_Toast_Captured">Captured {0}</system:String>
    <system:String x:Key="Loc_Toast_SavedAndCopied">Saved to folder and copied to clipboard!</system:String>
    <system:String x:Key="Loc_Toast_SavedOnly">Saved image to Screenshots folder!</system:String>
    <system:String x:Key="Loc_Toast_CopiedOnly">Copied image to clipboard!</system:String>
    <system:String x:Key="Loc_Toast_CaptureError">Capture Error</system:String>
    <system:String x:Key="Loc_Monitor_Primary"> (Primary)</system:String>
    <system:String x:Key="Loc_Monitor_Prefix">Display </system:String>
</ResourceDictionary>

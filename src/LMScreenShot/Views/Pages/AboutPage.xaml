<Page x:Class="LMScreenShot.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="Thông tin">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <!-- 1. Page Title -->
            <TextBlock Text="Thông tin" 
                       FontSize="24" 
                       FontWeight="Medium" 
                       Margin="0,0,0,24" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- 2. App Name & Version Info -->
            <TextBlock Text="LMScreenShot" 
                       FontSize="16" 
                       FontWeight="Medium" 
                       Margin="0,0,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Phiên bản 1.0.0" 
                       FontSize="13" 
                       Margin="0,0,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Bản dựng 20261024" 
                       FontSize="13" 
                       Margin="0,0,0,16" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Never gonna give you up!" 
                       FontSize="13" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- 3. Section Title (Liên kết) -->
            <TextBlock Text="Liên kết" 
                       FontSize="14" 
                       FontWeight="Medium" 
                       Margin="0,24,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:HyperlinkButton Content="Dự án LMScreenShot trên GitHub" 
                                    NavigateUri="https://github.com" 
                                    Margin="0,0,0,4" />
            </StackPanel>

            <!-- 4. Section Title (Thư viện bên thứ ba) -->
            <TextBlock Text="Thư viện bên thứ ba" 
                       FontSize="14" 
                       FontWeight="Medium" 
                       Margin="0,24,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <WrapPanel>
                <ui:HyperlinkButton Content="WPF-UI (lepoco/wpfui)" 
                                    NavigateUri="https://github.com/lepoco/wpfui" 
                                    Margin="0,0,12,6" />
                <ui:HyperlinkButton Content="CommunityToolkit.Mvvm" 
                                    NavigateUri="https://github.com/CommunityToolkit/dotnet" 
                                    Margin="0,0,12,6" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

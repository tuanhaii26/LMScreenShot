<Page x:Class="LMScreenShot.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:LMScreenShot.Core.Behaviors"
      mc:Ignorable="d"
      Title="{DynamicResource Loc_About_Title}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="28,20,28,28">
            <!-- 1. Page Title -->
            <TextBlock Text="{DynamicResource Loc_About_Title}" 
                       FontSize="24" 
                       FontWeight="Medium" 
                       Margin="0,0,0,24" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- 2. App Name & Version Info -->
            <TextBlock Text="LMScreenShot" 
                       FontSize="16" 
                       FontWeight="Medium" 
                       Margin="0,0,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TxtVersion" 
                       FontSize="13" 
                       Margin="0,0,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TxtBuild" 
                       FontSize="13" 
                       Margin="0,0,0,16" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Never gonna give you up!" 
                       FontSize="13" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- 3. Section Title (Liên kết) -->
            <TextBlock Text="{DynamicResource Loc_About_Links}" 
                       FontSize="14" 
                       FontWeight="Medium" 
                       Margin="0,24,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:HyperlinkButton Content="{DynamicResource Loc_About_GitHub}" 
                                    NavigateUri="https://github.com/tuanhaii26/LMScreenShot" 
                                    Margin="0,0,0,4" />
            </StackPanel>

            <!-- 4. Section Title (Thư viện bên thứ ba) -->
            <TextBlock Text="{DynamicResource Loc_About_ThirdParty}" 
                       FontSize="14" 
                       FontWeight="Medium" 
                       Margin="0,24,0,8" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <WrapPanel>
                <ui:HyperlinkButton Content="WPF-UI (lepoco/wpfui)" 
                                    NavigateUri="https://github.com/lepoco/wpfui" 
                                    Margin="0,0,12,6" />
                <ui:HyperlinkButton Content="CommunityToolkit.Mvvm" 
                                    NavigateUri="https://github.com/CommunityToolkit/dotnet" 
                                    Margin="0,0,12,6" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

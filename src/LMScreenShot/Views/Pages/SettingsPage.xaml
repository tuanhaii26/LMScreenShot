<Page x:Class="LMScreenShot.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:behaviors="clr-namespace:LMScreenShot.Core.Behaviors"
      mc:Ignorable="d"
      Title="{DynamicResource Loc_Settings_Title}">

    <Page.Resources>
        <!-- Style Card cài đặt chuẩn 1:1 theo Lenovo Legion Toolkit (LLT) -->
        <Style x:Key="LltSettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="28,20,28,28">
            <!-- Page Title -->
            <TextBlock Text="{DynamicResource Loc_Settings_Title}" 
                       FontSize="24" 
                       FontWeight="Medium" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       Margin="0,0,0,20" />

            <!-- Card 1: Thư mục lưu ảnh mặc định -->
            <Border Style="{StaticResource LltSettingCardStyle}">
                <DockPanel>
                    <ui:Button Content="{DynamicResource Loc_Settings_ChangeFolder}" 
                               Appearance="Secondary" 
                               DockPanel.Dock="Right" 
                               VerticalAlignment="Center" 
                               Click="BtnChangeFolder_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Loc_Settings_DefaultFolder}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="TxtFolderPath" 
                                   Text="Pictures/Screenshots" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 2: Thu nhỏ xuống khay hệ thống (Minimize to Tray) -->
            <Border Style="{StaticResource LltSettingCardStyle}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="ToggleMinimizeToTray" 
                                     IsChecked="True" 
                                     DockPanel.Dock="Right" 
                                     VerticalAlignment="Center" 
                                     Click="ToggleMinimizeToTray_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Loc_Settings_MinimizeToTray}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Settings_MinimizeToTrayDesc}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 3: Thu nhỏ khi đóng cửa sổ (Minimize on Close) -->
            <Border Style="{StaticResource LltSettingCardStyle}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="ToggleMinimizeOnClose" 
                                     IsChecked="False" 
                                     DockPanel.Dock="Right" 
                                     VerticalAlignment="Center" 
                                     Click="ToggleMinimizeOnClose_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Loc_Settings_MinimizeOnClose}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Settings_MinimizeOnCloseDesc}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 4: Khởi động cùng máy tính (Start with Windows) -->
            <Border Style="{StaticResource LltSettingCardStyle}">
                <DockPanel>
                    <ComboBox x:Name="ComboStartup" 
                              Width="150" 
                              DockPanel.Dock="Right" 
                              VerticalAlignment="Center" 
                              SelectionChanged="ComboStartup_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Loc_Settings_StartupOff}" Tag="0" />
                        <ComboBoxItem Content="{DynamicResource Loc_Settings_StartupOn}" Tag="1" />
                        <ComboBoxItem Content="{DynamicResource Loc_Settings_StartupMinimized}" Tag="2" />
                    </ComboBox>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Loc_Settings_Startup}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Settings_StartupDesc}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 3: Chế độ giao diện (Dark / Light) -->
            <Border Style="{StaticResource LltSettingCardStyle}">
                <DockPanel>
                    <ui:ToggleSwitch x:Name="ToggleDarkMode" 
                                     IsChecked="True" 
                                     DockPanel.Dock="Right" 
                                     VerticalAlignment="Center" 
                                     Click="ToggleDarkMode_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Loc_Settings_Theme}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Settings_ThemeDesc}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 4: Ngôn ngữ hiển thị (Language) -->
            <Border Style="{StaticResource LltSettingCardStyle}">
                <DockPanel>
                    <ComboBox x:Name="ComboLanguage" 
                              Width="140" 
                              DockPanel.Dock="Right" 
                              VerticalAlignment="Center" 
                              SelectionChanged="ComboLanguage_SelectionChanged">
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Loc_Settings_Language}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Settings_LanguageDesc}" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,3,0,0" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

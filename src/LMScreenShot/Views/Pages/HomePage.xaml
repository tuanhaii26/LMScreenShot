<Page x:Class="LMScreenShot.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="Trang chủ">

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Title chuẩn như Tab About -->
        <TextBlock Grid.Row="0"
                   Text="Trang chủ" 
                   FontSize="24" 
                   FontWeight="Medium" 
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                   Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột 1 (Trái): Thẻ Ảnh chụp mới ở trên & 2 thẻ Toggle ở dưới -->
                <ColumnDefinition Width="*" />
                <!-- Cột 2 (Phải): Khung hiển thị các màn hình -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card: Ảnh chụp mới -->
                <Border Grid.Row="0" 
                        x:Name="CardNewCapture"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand"
                        MouseDown="CardNewCapture_MouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="+" 
                                       FontSize="54" 
                                       FontWeight="Light" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Ảnh chụp mới" 
                                       FontSize="13" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2 Toggle cài đặt nằm cạnh nhau dưới Ảnh chụp mới -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Toggle 1: Lưu ảnh ngay sau khi chụp -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14,14">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Lưu ảnh ngay sau khi chụp" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="120" />
                            <ui:ToggleSwitch x:Name="ToggleAutoSave" 
                                             IsChecked="True" 
                                             DockPanel.Dock="Right" 
                                             VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Toggle 2: Tự động sao chép vào bảng tạm -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14,14">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Tự động sao chép vào bảng tạm" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="120" />
                            <ui:ToggleSwitch x:Name="ToggleAutoClipboard" 
                                             IsChecked="True" 
                                             DockPanel.Dock="Right" 
                                             VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- CỘT PHẢI: KHUNG HIỂN THỊ CÁC MÀN HÌNH -->
            <Border Grid.Column="1" 
                    Margin="18,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header Subtitle -->
                    <TextBlock x:Name="TxtMonitorSummary" 
                               Grid.Row="0" 
                               Text="Đang quét màn hình..." 
                               FontSize="13" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Left" 
                               Margin="6,0,0,16" />

                    <!-- Dynamic Topology Canvas Container -->
                    <Canvas x:Name="CanvasMonitors" 
                            Grid.Row="1" 
                            ClipToBounds="True" 
                            SizeChanged="CanvasMonitors_SizeChanged" />
                </Grid>
            </Border>
        </Grid>

        <!-- Snackbar Presenter hiển thị thông báo chụp thành công với timeout 2 giây -->
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,24" />
    </Grid>
</Page>

<Window x:Class="LMScreenShot.Views.Windows.ScreenOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Title="ScreenOverlay">

    <Grid x:Name="RootGrid" Background="#35000000" Cursor="Cross" MouseDown="RootGrid_MouseDown">
        <!-- Badge số thứ tự màn hình ở góc trái dưới (cho chế độ Capture & Identify) -->
        <Border x:Name="NumberBadge" 
                Width="84" 
                Height="84" 
                CornerRadius="8" 
                Background="#2B2B2B" 
                BorderBrush="#484848" 
                BorderThickness="1" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="32,0,0,32">
            <TextBlock x:Name="TxtNumber" 
                       Text="1" 
                       FontSize="36" 
                       FontWeight="SemiBold" 
                       Foreground="White" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
        </Border>

        <!-- Hướng dẫn phím tắt nhỏ ở chế độ Capture -->
        <Border x:Name="TipBadge"
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,28,0,0" 
                Background="#2B2B2B" 
                BorderBrush="#484848" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="16,8">
            <TextBlock x:Name="TxtTip" 
                       Text="{DynamicResource Loc_Overlay_Tip}" 
                       FontSize="13" 
                       Foreground="White" />
        </Border>

        <!-- Toast thông báo đã chụp ảnh ở phía dưới giữa màn hình (chế độ Notification) -->
        <Border x:Name="NotificationBadge" 
                Visibility="Collapsed"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="0,0,0,54"
                Background="#242424" 
                BorderBrush="#444444" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16,10">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotificationTransform" Y="0" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" 
                               Filled="True"
                               FontSize="20" 
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" 
                               Margin="0,0,12,0" 
                               VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNotificationTitle" 
                               Text="Đã chụp màn hình" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="White" />
                    <TextBlock x:Name="TxtNotificationSub" 
                               Text="Đã lưu vào Screenshots &amp; sao chép vào Clipboard" 
                               FontSize="11" 
                               Foreground="#AAAAAA" 
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

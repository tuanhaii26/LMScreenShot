<ui:FluentWindow x:Class="LMScreenShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="LMScreenShot"
        Height="580" Width="1080"
        MinHeight="500" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <!-- Style Navigation Item chuẩn 1:1 theo Lenovo Legion Toolkit -->
        <Style x:Key="LltNavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Mặc định BorderBrush={x:Null} và BorderThickness=0: TUYỆT ĐỐI KHÔNG CÓ OUTLINE KHI INACTIVE -->
                        <Border x:Name="MainBorder"
                                Padding="2"
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <Grid>
                                <!-- Vạch Active Indicator màu xanh ở sát mép trái -->
                                <Rectangle x:Name="ActiveRectangle"
                                           Width="3.5"
                                           Height="24"
                                           Margin="-2,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Opacity="0.0"
                                           RadiusX="1.75"
                                           RadiusY="1.75"
                                           Fill="{DynamicResource SystemAccentColorPrimaryBrush}" />

                                <!-- Khung Icon & Label -->
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Icon: Kích thước 22px chuẩn LLT, tự động đổi màu theo Theme -->
                                    <ui:SymbolIcon x:Name="PART_SymbolIcon"
                                                   Grid.Row="0"
                                                   Margin="0,3,0,0"
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Symbol="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{TemplateBinding Foreground}" />

                                    <!-- Khung chữ Label: Font 11px thông thoáng chuẩn LLT (Thu gọn mượt mà khi Active) -->
                                    <Grid x:Name="ContentGrid"
                                          Grid.Row="1"
                                          Margin="0,2,0,4"
                                          MaxHeight="26"
                                          Opacity="1">
                                        <TextBlock x:Name="ElementText"
                                                   FontSize="11"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Text="{TemplateBinding Tag}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- KHI ĐƯỢC KÍCH HOẠT (ACTIVE): HIỆN KHUNG NỔI MICA, VẠCH XANH, TÔ MÀU ACCENT, FILLED ICON VÀ ẨN CHỮ -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1.0" />
                                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="PART_SymbolIcon" Property="Filled" Value="True" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                                             Storyboard.TargetProperty="MaxHeight"
                                                             From="26" To="0"
                                                             Duration="0:0:.16" />
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0"
                                                             Duration="0:0:.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                                             Storyboard.TargetProperty="MaxHeight"
                                                             From="0" To="26"
                                                             Duration="0:0:.16" />
                                            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- KHI RÊ CHUỘT (HOVER TRÊN TAB KHÔNG ACTIVE): KHÔNG OUTLINE, CHỈ NỀN SUBTLE -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{x:Null}" />
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="LMScreenShot" />

        <!-- Main Body: 2 Columns Layout chuẩn LLT -->
        <Grid Grid.Row="1" Margin="6,4,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COMPACT NAVIGATION RAIL: Chiều rộng 74px chuẩn tỉ lệ 1:1 theo Lenovo Legion Toolkit -->
            <Grid Grid.Column="0" Width="74" Margin="4,0,8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Menu Items -->
                <StackPanel Grid.Row="0">
                    <RadioButton Style="{StaticResource LltNavigationItemStyle}"
                                 Content="{x:Static ui:SymbolRegular.Home24}"
                                 Tag="Trang chủ"
                                 GroupName="NavGroup"
                                 IsChecked="True"
                                 Click="NavHome_Click" />

                    <RadioButton Style="{StaticResource LltNavigationItemStyle}"
                                 Content="{x:Static ui:SymbolRegular.Camera24}"
                                 Tag="Ảnh chụp"
                                 GroupName="NavGroup"
                                 Click="NavGallery_Click" />

                    <RadioButton Style="{StaticResource LltNavigationItemStyle}"
                                 Content="{x:Static ui:SymbolRegular.Flash24}"
                                 Tag="Phím tắt"
                                 GroupName="NavGroup"
                                 Click="NavShortcuts_Click" />
                </StackPanel>

                <!-- Footer Menu Items (Cài đặt & About ở dưới cùng) -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource LltNavigationItemStyle}"
                                 Content="{x:Static ui:SymbolRegular.Settings24}"
                                 Tag="Cài đặt"
                                 GroupName="NavGroup"
                                 Click="NavSettings_Click" />

                    <RadioButton Style="{StaticResource LltNavigationItemStyle}"
                                 Content="{x:Static ui:SymbolRegular.Info24}"
                                 Tag="Thông tin"
                                 GroupName="NavGroup"
                                 Click="NavAbout_Click" />
                </StackPanel>
            </Grid>

            <!-- RIGHT CONTENT CANVAS: Khung viền bo góc ôm trọn khu vực trang chuẩn LLT -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" Navigated="RootFrame_Navigated" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
